���������������������������������������������������������������������MCSim/app/src/main/java/com/example/����������������������������������������������������������������0000755�0000000�0000000�00000000000�15263665413�016164� 5����������������������������������������������������������������������������������������������������ustar  �root����������������������������root�������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������MCSim/app/src/main/java/com/example/mcsim/����������������������������������������������������������0000755�0000000�0000000�00000000000�15263665442�017276� 5����������������������������������������������������������������������������������������������������ustar  �root����������������������������root�������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������MCSim/app/src/main/java/com/example/mcsim/MainActivity.kt�������������������������������������������0000644�0000000�0000000�00000006532�15263665442�022245� 0����������������������������������������������������������������������������������������������������ustar  �root����������������������������root�������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������package com.example.mcsim

import android.app.Activity
import android.graphics.Typeface
import android.os.Bundle
import android.text.InputType
import android.view.Gravity
import android.widget.*

class MainActivity : Activity() {

    private lateinit var log: TextView
    private lateinit var scroll: ScrollView

    private fun dp(v: Int) = (v * resources.displayMetrics.density).toInt()

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)

        val root = LinearLayout(this).apply {
            orientation = LinearLayout.VERTICAL
            setPadding(dp(16), dp(32), dp(16), dp(16))
        }
        root.addView(TextView(this).apply { text = "MC Server Tester"; textSize = 22f; setTypeface(null, Typeface.BOLD) })

        val group = RadioGroup(this).apply { orientation = RadioGroup.HORIZONTAL }
        val rbJava = RadioButton(this).apply { text = "Java"; id = 1; isChecked = true }
        val rbBedrock = RadioButton(this).apply { text = "Bedrock"; id = 2 }
        group.addView(rbJava); group.addView(rbBedrock)
        root.addView(group)

        val ip = EditText(this).apply { hint = "Server-IP oder Domain"; inputType = InputType.TYPE_TEXT_VARIATION_URI or InputType.TYPE_CLASS_TEXT; setSingleLine() }
        val port = EditText(this).apply { hint = "Port"; setText("25565"); inputType = InputType.TYPE_CLASS_NUMBER; setSingleLine() }
        val name = EditText(this).apply { hint = "Spielername"; setText("TestBot"); setSingleLine() }
        root.addView(ip); root.addView(port); root.addView(name)

        group.setOnCheckedChangeListener { _, id ->
            val cur = port.text.toString()
            if (cur == "25565" || cur == "19132" || cur.isEmpty()) port.setText(if (id == 1) "25565" else "19132")
            name.isEnabled = id == 1
        }

        val btn = Button(this).apply { text = "Testen (Ping + Join)" }
        root.addView(btn)

        log = TextView(this).apply { typeface = Typeface.MONOSPACE; textSize = 14f; setTextIsSelectable(true) }
        scroll = ScrollView(this).apply { addView(log) }
        root.addView(scroll, LinearLayout.LayoutParams(-1, 0, 1f))

        btn.setOnClickListener {
            val host = ip.text.toString().trim()
            val p = port.text.toString().toIntOrNull()
            val nick = name.text.toString().trim().ifEmpty { "TestBot" }
            if (host.isEmpty() || p == null || p !in 1..65535) { toast("IP/Port ungültig"); return@setOnClickListener }
            log.text = ""
            btn.isEnabled = false
            val java = group.checkedRadioButtonId == 1
            append("→ ${if (java) "Java" else "Bedrock"} $host:$p")
            Thread {
                val ok = try {
                    if (java) JavaClient.test(host, p, nick) { append(it) }
                    else BedrockClient.test(host, p) { append(it) }
                } catch (e: Exception) { append("Fehler: ${e.message}"); false }
                runOnUiThread { append(if (ok) "=== ERGEBNIS: GEJOINT ===" else "=== ERGEBNIS: NICHT GEJOINT ==="); btn.isEnabled = true }
            }.start()
        }
        setContentView(root)
    }

    private fun toast(s: String) = Toast.makeText(this, s, Toast.LENGTH_SHORT).show()

    private fun append(line: String) = runOnUiThread {
        log.append(line + "\n")
        scroll.post { scroll.fullScroll(ScrollView.FOCUS_DOWN) }
    }
}
����������������������������������������������������������������������������������������������������������������������������������������������������������������������MCSim/app/src/main/java/com/example/mcsim/BedrockClient.kt������������������������������������������0000644�0000000�0000000�00000007651�15263665442�022357� 0����������������������������������������������������������������������������������������������������ustar  �root����������������������������root�������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������package com.example.mcsim

import java.net.DatagramPacket
import java.net.DatagramSocket
import java.net.Inet4Address
import java.net.InetAddress
import java.nio.ByteBuffer

/** Minecraft Bedrock Edition: RakNet Unconnected Ping + Verbindungs-Handshake. */
object BedrockClient {

    private val MAGIC = intArrayOf(
        0x00, 0xff, 0xff, 0x00, 0xfe, 0xfe, 0xfe, 0xfe,
        0xfd, 0xfd, 0xfd, 0xfd, 0x12, 0x34, 0x56, 0x78
    ).map { it.toByte() }.toByteArray()

    private val clientGuid = System.nanoTime()

    private fun exchange(sock: DatagramSocket, addr: InetAddress, port: Int, data: ByteArray): ByteArray? {
        return try {
            sock.send(DatagramPacket(data, data.size, addr, port))
            val buf = ByteArray(2048)
            val p = DatagramPacket(buf, buf.size)
            sock.receive(p)
            buf.copyOf(p.length)
        } catch (e: java.net.SocketTimeoutException) { null }
    }

    fun test(host: String, port: Int, log: (String) -> Unit): Boolean {
        val addr = try {
            InetAddress.getAllByName(host).firstOrNull { it is Inet4Address } ?: InetAddress.getByName(host)
        } catch (e: Exception) { log("DNS-Fehler: ${e.message}"); return false }

        DatagramSocket().use { sock ->
            sock.soTimeout = 4000
            // ---------- 1) Unconnected Ping ----------
            val t = System.currentTimeMillis()
            val ping = ByteBuffer.allocate(33).apply {
                put(0x01); putLong(t); put(MAGIC); putLong(clientGuid)
            }.array()
            val start = System.nanoTime()
            val pong = exchange(sock, addr, port, ping)
            val ms = (System.nanoTime() - start) / 1_000_000
            if (pong == null || pong.isEmpty() || pong[0] != 0x1c.toByte() || pong.size < 35) {
                log("Keine Antwort auf Ping (Server offline, falscher Port oder kein Bedrock-Server)")
                return false
            }
            val len = ((pong[33].toInt() and 0xFF) shl 8) or (pong[34].toInt() and 0xFF)
            val info = String(pong, 35, minOf(len, pong.size - 35), Charsets.UTF_8).split(";")
            log("Ping: $ms ms")
            log("MOTD: ${info.getOrNull(1)}")
            log("Version: ${info.getOrNull(3)} (Protokoll ${info.getOrNull(2)})")
            log("Spieler: ${info.getOrNull(4)} / ${info.getOrNull(5)}")

            // ---------- 2) RakNet Open Connection Handshake ----------
            var mtu = 0
            for (size in intArrayOf(1400, 1200, 576)) {
                val req1 = ByteBuffer.allocate(size).apply { put(0x05); put(MAGIC); put(11) }.array()
                val r1 = exchange(sock, addr, port, req1) ?: continue
                if (r1[0] == 0x19.toByte()) { log("Join NICHT möglich: inkompatibles RakNet-Protokoll"); return false }
                if (r1[0] == 0x06.toByte() && r1.size >= 28) {
                    mtu = ((r1[26].toInt() and 0xFF) shl 8) or (r1[27].toInt() and 0xFF)
                    break
                }
            }
            if (mtu == 0) { log("Join NICHT möglich: kein Open-Connection-Reply"); return false }

            val ip = addr.address
            val req2 = ByteBuffer.allocate(34).apply {
                put(0x07); put(MAGIC)
                put(4)
                if (ip.size == 4) ip.forEach { put(it.toInt().inv().toByte()) } else repeat(4) { put(0) }
                putShort(port.toShort())
                putShort(mtu.toShort())
                putLong(clientGuid)
            }.array()
            val r2 = exchange(sock, addr, port, req2)
            if (r2 != null && r2[0] == 0x08.toByte()) {
                log("✅ VERBINDUNG ERFOLGREICH (RakNet-Handshake, MTU $mtu)")
                log("Hinweis: Der Spiel-Login von Bedrock benötigt Xbox-Live-Authentifizierung und wird nicht ausgeführt.")
                return true
            }
            log("Join NICHT möglich: kein Connection-Reply (Server hat Verbindung abgelehnt)")
            return false
        }
    }
}
���������������������������������������������������������������������������������������MCSim/app/src/main/java/com/example/mcsim/JavaClient.kt���������������������������������������������0000644�0000000�0000000�00000016167�15263665442�021671� 0����������������������������������������������������������������������������������������������������ustar  �root����������������������������root�������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������package com.example.mcsim

import org.json.JSONObject
import java.io.*
import java.net.InetSocketAddress
import java.net.Socket
import java.nio.charset.StandardCharsets
import java.util.UUID
import java.util.zip.Inflater

/** Minecraft Java Edition: Server-List-Ping + Login-Test (Offline-Mode). */
object JavaClient {

    private fun writeVarInt(o: OutputStream, v: Int) {
        var x = v
        while (true) {
            if ((x and 0x7F.inv()) == 0) { o.write(x); return }
            o.write((x and 0x7F) or 0x80)
            x = x ushr 7
        }
    }

    private fun readVarInt(i: InputStream): Int {
        var r = 0; var s = 0
        while (true) {
            val b = i.read()
            if (b < 0) throw EOFException("Verbindung geschlossen")
            r = r or ((b and 0x7F) shl s)
            if ((b and 0x80) == 0) return r
            s += 7
            if (s > 35) throw IOException("VarInt zu gross")
        }
    }

    private fun writeString(o: OutputStream, s: String) {
        val b = s.toByteArray(StandardCharsets.UTF_8)
        writeVarInt(o, b.size); o.write(b)
    }

    private fun readString(i: InputStream): String {
        val len = readVarInt(i)
        val b = ByteArray(len)
        DataInputStream(i).readFully(b)
        return String(b, StandardCharsets.UTF_8)
    }

    private fun sendPacket(out: OutputStream, id: Int, compression: Int, build: (ByteArrayOutputStream) -> Unit) {
        val body = ByteArrayOutputStream()
        if (compression >= 0) writeVarInt(body, 0) // Data Length 0 = unkomprimiert (Pakete sind klein)
        writeVarInt(body, id)
        build(body)
        writeVarInt(out, body.size())
        body.writeTo(out)
        out.flush()
    }

    private class Packet(val id: Int, val data: ByteArrayInputStream)

    private fun readPacket(inp: InputStream, compression: Int): Packet {
        val len = readVarInt(inp)
        val raw = ByteArray(len)
        DataInputStream(inp).readFully(raw)
        var stream: InputStream = ByteArrayInputStream(raw)
        if (compression >= 0) {
            val dataLen = readVarInt(stream)
            if (dataLen != 0) {
                val rest = stream.readBytes()
                val inf = Inflater()
                inf.setInput(rest)
                val out = ByteArray(dataLen)
                var off = 0
                while (off < dataLen && !inf.finished()) {
                    val n = inf.inflate(out, off, dataLen - off)
                    if (n == 0 && (inf.needsInput() || inf.needsDictionary())) break
                    off += n
                }
                inf.end()
                stream = ByteArrayInputStream(out)
            }
        }
        val id = readVarInt(stream)
        return Packet(id, ByteArrayInputStream(stream.readBytes()))
    }

    private fun handshake(out: OutputStream, host: String, port: Int, protocol: Int, state: Int) {
        sendPacket(out, 0x00, -1) {
            writeVarInt(it, protocol)
            writeString(it, host)
            it.write((port shr 8) and 0xFF); it.write(port and 0xFF)
            writeVarInt(it, state)
        }
    }

    private fun motdText(d: Any?): String = when (d) {
        is String -> d
        is JSONObject -> {
            val sb = StringBuilder(d.optString("text", ""))
            d.optJSONArray("extra")?.let { for (k in 0 until it.length()) sb.append(motdText(it.get(k))) }
            sb.toString()
        }
        else -> ""
    }.replace(Regex("§."), "")

    fun test(host: String, port: Int, name: String, log: (String) -> Unit): Boolean {
        var protocol = 765
        // ---------- 1) Status + Ping ----------
        try {
            Socket().use { s ->
                s.soTimeout = 5000
                val t0 = System.nanoTime()
                s.connect(InetSocketAddress(host, port), 5000)
                log("TCP verbunden (${(System.nanoTime() - t0) / 1_000_000} ms)")
                val out = BufferedOutputStream(s.getOutputStream()); val inp = BufferedInputStream(s.getInputStream())
                handshake(out, host, port, protocol, 1)
                sendPacket(out, 0x00, -1) {}
                val resp = readPacket(inp, -1)
                val json = JSONObject(readString(resp.data))
                val pl = json.optJSONObject("players")
                val ver = json.optJSONObject("version")
                protocol = ver?.optInt("protocol", protocol) ?: protocol
                log("Version: ${ver?.optString("name")} (Protokoll $protocol)")
                log("Spieler: ${pl?.optInt("online")} / ${pl?.optInt("max")}")
                log("MOTD: ${motdText(json.opt("description")).trim()}")
                val ts = System.nanoTime()
                sendPacket(out, 0x01, -1) { DataOutputStream(it).writeLong(ts) }
                readPacket(inp, -1)
                log("Ping: ${(System.nanoTime() - ts) / 1_000_000} ms")
            }
        } catch (e: Exception) {
            log("Status fehlgeschlagen: ${e.javaClass.simpleName}: ${e.message}")
            return false
        }

        // ---------- 2) Login-Test ----------
        try {
            Socket().use { s ->
                s.soTimeout = 8000
                s.connect(InetSocketAddress(host, port), 5000)
                val out = BufferedOutputStream(s.getOutputStream()); val inp = BufferedInputStream(s.getInputStream())
                handshake(out, host, port, protocol, 2)
                val uuid = UUID.nameUUIDFromBytes("OfflinePlayer:$name".toByteArray(StandardCharsets.UTF_8))
                fun writeUuid(o: OutputStream) {
                    val d = DataOutputStream(o); d.writeLong(uuid.mostSignificantBits); d.writeLong(uuid.leastSignificantBits)
                }
                sendPacket(out, 0x00, -1) {
                    writeString(it, name)
                    when {
                        protocol >= 764 -> writeUuid(it)
                        protocol >= 761 -> { it.write(1); writeUuid(it) }
                        protocol >= 759 -> { it.write(0); it.write(1); writeUuid(it) }
                    }
                }
                var compression = -1
                repeat(10) {
                    val p = readPacket(inp, compression)
                    when (p.id) {
                        0x00 -> {
                            val raw = readString(p.data)
                            val reason = try {
                                val j = JSONObject(raw)
                                motdText(j).ifBlank { j.optString("translate", raw) }
                            } catch (e: Exception) { raw }
                            log("Join NICHT möglich: $reason"); return false
                        }
                        0x01 -> { log("Join NICHT möglich: Server ist im Online-Mode (Microsoft-Login nötig)."); return false }
                        0x03 -> compression = readVarInt(p.data)
                        0x02 -> { log("✅ JOIN ERFOLGREICH als '$name'"); return true }
                    }
                }
                log("Join unklar: keine Login-Antwort")
                return false
            }
        } catch (e: Exception) {
            log("Join fehlgeschlagen: ${e.javaClass.simpleName}: ${e.message}")
            return false
        }
    }

}
